name: "Kanka Librarian — Fogport: Cinderwheel"

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: kanka-librarian-fogport
  cancel-in-progress: false

jobs:
  publish:
    name: "FOGPORT ONLY (410879) — publish and verify Cinderwheel"
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install --requirement requirements.txt
      - name: Validate Librarian safety tests
        run: python -m unittest discover -s tests
      - name: Publish Cinderwheel item and approved image
        env:
          KANKA_API_TOKEN: ${{ secrets.KANKA_API_TOKEN }}
          KANKA_ENABLE_WRITES: FOGPORT_410879
        run: |
          python scripts/publish_cinderhack.py \
            kanka_librarian/approved_items/cinderwheel.json \
            --receipt receipts/cinderwheel.json
      - name: Preserve verified receipt
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kanka-cinderwheel-receipt
          path: receipts/cinderwheel.json
          if-no-files-found: error
          retention-days: 90
