name: "Kanka Librarian — Fogport: The Civic Order"

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: kanka-librarian-fogport
  cancel-in-progress: false

jobs:
  publish:
    name: "FOGPORT ONLY (410879) — publish and verify The Civic Order"
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install --requirement requirements.txt
      - name: Run Librarian safety tests
        run: python -m unittest discover -s tests
      - name: Restore and verify approved Hall of Civic Order artwork
        run: |
          cat assets/organizations/civic-order.png.b64.part-* | base64 --decode > assets/organizations/civic-order.png
          echo "f48eb5843205d3974060e0b8c475b4e901b04a6f9e17eaad63531d61d724a144  assets/organizations/civic-order.png" | sha256sum --check
      - name: Publish and verify The Civic Order
        env:
          KANKA_API_TOKEN: ${{ secrets.KANKA_API_TOKEN }}
          KANKA_ENABLE_WRITES: FOGPORT_410879
        run: |
          python scripts/publish_civic_order.py \
            kanka_librarian/approved_organizations/civic-order.json \
            --receipt receipts/civic-order.json
      - name: Preserve verified receipt
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kanka-civic-order-receipt
          path: receipts/civic-order.json
          if-no-files-found: error
          retention-days: 90
