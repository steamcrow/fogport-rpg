name: "Kanka Librarian — Fogport: Church of Orra"

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: kanka-librarian-fogport
  cancel-in-progress: false

jobs:
  publish:
    name: "FOGPORT ONLY (410879) — publish and verify Church of Orra"
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install --requirement requirements.txt
      - name: Run Librarian safety tests
        run: python -m unittest discover -s tests
      - name: Restore and verify approved Orrian clergy artwork
        run: |
          cat assets/organizations/church-of-orra-v2.jpg.b64.part-* | base64 --decode > assets/organizations/church-of-orra-v2.jpg
          echo "1f45f6593a413f5b9c536a5f0b542d13c2a6c6b19981feaef824a54d0ba7d788  assets/organizations/church-of-orra-v2.jpg" | sha256sum --check
      - name: Publish and verify Church of Orra
        env:
          KANKA_API_TOKEN: ${{ secrets.KANKA_API_TOKEN }}
          KANKA_ENABLE_WRITES: FOGPORT_410879
        run: |
          python scripts/publish_church_of_orra.py \
            kanka_librarian/approved_organizations/church-of-orra.json \
            --receipt receipts/church-of-orra.json
      - name: Preserve verified receipt
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kanka-church-of-orra-publication-receipt
          path: receipts/church-of-orra.json
          if-no-files-found: warn
          retention-days: 90
