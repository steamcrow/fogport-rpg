name: "Kanka Librarian — Publish Byl and Lott Portraits"

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: kanka-librarian-fogport
  cancel-in-progress: false

jobs:
  publish:
    name: "FOGPORT 410879 — publish Byl and Lott portraits and verify"
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install --requirement requirements.txt
      - name: Validate repository tests
        run: python -m unittest discover -s tests
      - name: Publish Byl Hasbaine and verify portrait
        env:
          KANKA_API_TOKEN: ${{ secrets.KANKA_API_TOKEN }}
          KANKA_ENABLE_WRITES: FOGPORT_410879
          PYTHONPATH: ${{ github.workspace }}
        run: |
          python scripts/publish_approved_character.py \
            kanka_librarian/approved_characters/byl-hasbaine.json \
            --receipt receipts/byl-hasbaine-with-artwork.json
      - name: Publish Lott and verify portrait
        env:
          KANKA_API_TOKEN: ${{ secrets.KANKA_API_TOKEN }}
          KANKA_ENABLE_WRITES: FOGPORT_410879
          PYTHONPATH: ${{ github.workspace }}
        run: |
          python scripts/publish_approved_character.py \
            kanka_librarian/approved_characters/lott.json \
            --receipt receipts/lott-with-artwork.json
      - name: Preserve verified receipts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kanka-byl-lott-artwork-receipts
          path: receipts/*-with-artwork.json
          if-no-files-found: warn
          retention-days: 90
