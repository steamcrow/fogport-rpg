name: "Kanka Librarian — Repair Lastlight Parent Only"

on:
  workflow_dispatch:
  push:
    paths:
      - ".github/workflows/repair-lastlight-parent.yml"
      - "scripts/repair_lastlight_parent.py"

permissions:
  contents: read

concurrency:
  group: kanka-librarian-fogport
  cancel-in-progress: false

jobs:
  repair:
    name: "FOGPORT ONLY (410879) — set Lastlight parent to Blackwake"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install --requirement requirements.txt
      - name: Change only Lastlight parent
        env:
          KANKA_API_TOKEN: ${{ secrets.KANKA_API_TOKEN }}
          KANKA_ENABLE_WRITES: FOGPORT_410879
        run: |
          python scripts/repair_lastlight_parent.py \
            --receipt receipts/repair-lastlight-parent.json
      - name: Preserve repair receipt
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kanka-repair-lastlight-parent-receipt
          path: receipts/repair-lastlight-parent.json
          if-no-files-found: warn
          retention-days: 90
